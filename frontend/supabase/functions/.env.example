# Copy to supabase/functions/.env; upload these as Supabase Edge Function secrets.
# Never import this file into React or prefix secrets with VITE_.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Portfolio <contact@your-verified-domain.example>
CONTACT_TO_EMAIL=your-receiving-address@gmail.com
# Exact origins, no trailing slash. Add your current Codespace frontend URL.
CONTACT_ALLOWED_ORIGINS=http://localhost:5173,https://deepanshugulia.in
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by the hosted Edge runtime.
