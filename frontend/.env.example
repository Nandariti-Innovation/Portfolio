# Browser-safe values only. Never add VITE_RESEND_API_KEY or a service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-existing-public-anon-key

# Development traffic is excluded unless explicitly enabled.
VITE_TRACK_VISITORS_IN_DEV=false
# IPWHOIS browser endpoint. Location is fetched once and cached for the visitor session.
VITE_VISITOR_GEO_URL=https://ipwho.is/
